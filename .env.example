# ---- Provider ----------------------------------------------------------------
OPENAI_API_KEY=sk-your-project-key-here     # never commit a real key; the Streamlit app can ask for it instead
LLM_MODEL=gpt-4o-mini                        # chat model (verify identifier in current docs)
EMBEDDING_MODEL=text-embedding-3-small       # same model MUST be used for indexing and querying
TEMPERATURE=0.0                              # grounded support answers: deterministic

# ---- Index -------------------------------------------------------------------
KB_DIR=data/knowledge_base
VECTOR_STORE_DIR=data/vector_store
COLLECTION_NAME=pearlz_kb
CHUNK_SIZE=800                               # characters (see chunking experiment)
CHUNK_OVERLAP=120                            # ~15% of chunk size
CHUNK_STRATEGY=structure                     # structure | recursive

# ---- Retrieval ----------------------------------------------------------------
RETRIEVAL_K=4                                # chunks passed to the LLM
FETCH_K=20                                   # candidates considered (MMR / gate)
SEARCH_TYPE=mmr                              # similarity | mmr | threshold
MMR_LAMBDA=0.6                               # 1 = pure relevance, 0 = pure diversity
SCORE_THRESHOLD=0.30                         # relevance gate; calibrate on YOUR data (Task 06)

# ---- Conversation & generation -------------------------------------------------
HISTORY_TURNS=4                              # window of past turns used for query condensation
MAX_CONTEXT_CHARS=6000                       # context budget injected into the prompt
PROMPT_VERSION=v3                            # v1 (weak baseline) | v2 | v3 (final)
REQUEST_TIMEOUT_S=45
MAX_RETRIES=3
LOG_LEVEL=INFO
